*.sqlite3
*.db

# Node.js / React
node_modules/
dist/
build/
.vite/

# IDE / Editors
.vscode/
.idea/
*.swp

# OS Files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
