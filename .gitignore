.env.development
.env.production
backend/.env
frontend/.env

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
*.sqlite3
*.db

# Node.js / React
node_modules/
dist/
build/
.vite/

# IDE

